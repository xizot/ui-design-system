{
  "name": "ui-design-system",
  "version": "0.1.0",
  "private": false,
  "bin": {
    "ui-design-system": "bin/install.cjs"
  },
  "files": [
    "bin",
    "app/globals.css",
    "components",
    "constants",
    ".agents/skills",
    ".agents/rules",
    "hooks",
    "lib",
    "public",
    "AGENTS.md",
    "README.md",
    "package.json",
    "dist",
    "scripts/build-package.cjs",
    "tsconfig.package.json"
  ],
  "scripts": {
    "dev": "next dev --port 6001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "build:package": "node scripts/build-package.cjs",
    "prepare": "npm run build:package",
    "test:package": "node --test scripts/package.test.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@shadcn/react": "^0.2.1",
    "cn": "^0.3.0",
    "react-hook-form": "^7.72.1"
  },
  "description": "React UI components with source-copy and ESM package installation modes.",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.1",
    "tailwindcss": "^4.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./components/ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    },
    "./components/rhf/*": {
      "types": "./dist/components/rhf/*.d.ts",
      "import": "./dist/components/rhf/*.js",
      "default": "./dist/components/rhf/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.js",
      "default": "./dist/constants/*.js"
    },
    "./components/rhf": {
      "types": "./dist/components/rhf/index.d.ts",
      "import": "./dist/components/rhf/index.js",
      "default": "./dist/components/rhf/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
